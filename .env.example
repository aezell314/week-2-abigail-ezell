# Copy this file to `.env` and adjust if needed:  cp .env.example .env
# These match the defaults in docker-compose.yml, so the copy works as-is.

# Where the S3 API lives (RustFS running via docker compose).
S3_ENDPOINT_URL=http://localhost:9000

# Credentials for the local object store.
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin

# boto3 wants a region even when talking to a non-AWS store. Any value works.
S3_REGION=us-east-1

# The bucket the seed script creates and the pipeline reads from.
S3_BUCKET=raw

# Object keys for the two source files seeded into the bucket.
ORDERS_KEY=orders.csv
CUSTOMERS_KEY=customers.json
